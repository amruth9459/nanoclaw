
# Agent Identity & Trust
# Controls how the identity layer handles unsigned messages during migration.
# - "warn": Accept unsigned messages with warnings in evidence chain (default)
# - "strict": Reject messages from agents without valid identity
NANOCLAW_IDENTITY_ENFORCEMENT=warn

# ── Cloudflare Integration ────────────────────────────────────────────────
# Enables the cloudflare_* MCP tools (deploy Pages/Workers, manage DNS,
# create tunnels, register domains). Account creation must still be done
# once at https://dash.cloudflare.com/sign-up — the API can't sign up.
#
# Token: create at https://dash.cloudflare.com/profile/api-tokens with
# permissions: Zone:Edit, Worker:Edit, Pages:Edit, Tunnel:Edit, Registrar:Read.
# Add Registrar:Edit only if you want the agent to register domains.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# HITL safety caps for cloudflare_register_domain. Domain registrations
# always require WhatsApp approval; these caps reject the proposal outright
# (no prompt) when exceeded — bump them if you want to register pricier TLDs
# or longer terms.
CLOUDFLARE_MAX_DOMAIN_PRICE_USD=50
CLOUDFLARE_MAX_REGISTRATION_YEARS=5
